{
  "design": {
    "reference": "https://benscott.dev/",
    "referencePurpose": "Use Ben Scott as a visual, structural and interaction reference, not as a source of personal content.",
    "structure": [
      "Navigation",
      "Hero",
      "About",
      "Skills",
      "Projects",
      "Contact",
      "Footer"
    ],
    "theme": {
      "mode": "dark",
      "background": "#181818",
      "textPrimary": "#ffffff",
      "textSecondary": "#cccccc",
      "accent": "#ff4d5a",
      "particleBlue": "#51a2e9"
    },
    "hero": {
      "height": "100vh",
      "alignment": "center",
      "textAlignment": "center",
      "largeTypography": true,
      "minimalLayout": true,
      "background": {
        "type": "interactive-canvas-particle-network",
        "fixed": true,
        "mouseInteraction": true,
        "scrollAware": true,
        "networkConnections": true,
        "pointerEvents": "none"
      }
    },
    "navigation": {
      "style": "minimal",
      "type": "single-page-anchor-navigation",
      "smoothScroll": true
    },
    "about": {
      "showBiography": true,
      "showSkills": true,
      "minimalPresentation": true
    },
    "skills": {
      "style": "minimal",
      "useOnlyContentData": true
    },
    "projects": {
      "style": "minimal",
      "component": "ProjectCard",
      "showDescription": true,
      "showTechnologies": true,
      "showLiveLinkWhenAvailable": true,
      "showSourceLinkWhenAvailable": true,
      "showImageWhenAvailable": true
    },
    "contact": {
      "simpleForm": true,
      "fields": [
        "name",
        "email",
        "message"
      ]
    },
    "responsive": {
      "desktop": {
        "layout": "full",
        "particleDensity": "high"
      },
      "tablet": {
        "reduceSpacing": true,
        "particleDensity": "medium"
      },
      "mobile": {
        "stackContent": true,
        "reduceTypography": true,
        "particleDensity": "low",
        "reduceParticleConnections": true
      }
    },
    "constraints": {
      "avoidGenericPortfolioTemplate": true,
      "avoidUnnecessaryGradients": true,
      "avoidExcessiveGlassmorphism": true,
      "avoidExcessiveCards": true,
      "avoidUnnecessaryAnimations": true,
      "doNotCopyBenScottContent": true
    }
  }
}
